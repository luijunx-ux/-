# Copy to a secret-managed location outside Git and replace every template value.
POSTGRES_DB=tianrenlu
POSTGRES_USER=tianrenlu
POSTGRES_PASSWORD=replace_with_random_database_password
DATABASE_URL=postgresql+asyncpg://tianrenlu:replace_with_url_encoded_password@postgres:5432/tianrenlu

JWT_SECRET_KEY=replace_with_at_least_32_random_characters
SAFETY_IDENTIFIER_SECRET=replace_with_a_different_random_secret
APP_PUBLIC_URL=https://app.example.com

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=replace_with_smtp_user
SMTP_PASSWORD=replace_with_smtp_password
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_USE_TLS=true

AI_ENABLED=false
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-5.6-terra

BIND_ADDRESS=127.0.0.1
BACKEND_PORT=8000
LOG_LEVEL=INFO
