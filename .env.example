# Runtime
APP_ENV=development
APP_NAME=tianrenlu
APP_TIMEZONE=UTC
LOG_LEVEL=INFO

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:3000

# PostgreSQL (template values only)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=tianrenlu
POSTGRES_USER=tianrenlu
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql+asyncpg://tianrenlu:change_me@localhost:5432/tianrenlu

# AI provider (never commit real keys)
LLM_PROVIDER=openai
AI_ENABLED=false
LLM_MODEL=gpt-5.6-terra
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_REASONING_EFFORT=low
LLM_TIMEOUT_SECONDS=20

# Authentication (replace both secrets; use a secret manager outside development)
JWT_SECRET_KEY=replace_with_at_least_32_random_characters
JWT_ISSUER=tianrenlu-api
JWT_AUDIENCE=tianrenlu-mobile
JWT_ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=30
SAFETY_IDENTIFIER_SECRET=replace_with_a_separate_random_secret
APP_PUBLIC_URL=https://app.example.com

# SMTP account email delivery
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# RAG / vector storage
VECTOR_STORE_PROVIDER=pgvector
EMBEDDING_MODEL=replace_with_embedding_model

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=

# Geocoding (public Nominatim requires <=1 request/second, caching and attribution)
GEOCODING_BASE_URL=https://nominatim.openstreetmap.org
GEOCODING_USER_AGENT=Tianrenlu/0.1 (+https://github.com/luijunx-ux/-)
GEOCODING_CACHE_SECONDS=86400
