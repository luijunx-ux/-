# Runtime
APP_ENV=development
APP_NAME=tianrenlu
APP_TIMEZONE=UTC
LOG_LEVEL=INFO

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:3000

# PostgreSQL (template values only)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=tianrenlu
POSTGRES_USER=tianrenlu
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql+asyncpg://tianrenlu:change_me@localhost:5432/tianrenlu

# AI provider (never commit real keys)
LLM_PROVIDER=openai
LLM_MODEL=replace_with_model_name
LLM_API_KEY=
LLM_BASE_URL=

# RAG / vector storage
VECTOR_STORE_PROVIDER=pgvector
EMBEDDING_MODEL=replace_with_embedding_model

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=

